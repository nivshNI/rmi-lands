# === Polling interval (seconds) — default: 10800 = 3 hours ===
POLL_INTERVAL_SECONDS=10800

# === Notification method (pick one or more: email, telegram, ntfy) ===
NOTIFY_VIA=email

# --- Email (SMTP) — recommended for Gmail users ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=your.email@gmail.com

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy.sh (optional — no signup needed) ---
NTFY_TOPIC=rmi-lands-alerts

# === RMI Search Filters ===
# Population priority codes (comma-separated):
#   1 = אנשים עם מוגבלות
#   6 = חיילי מילואים
#   4 = בני מיעוטים מומלצי כוחות הביטחון
#  16 = בני מקום
#   3 = חסרי דיור
RMI_UCHLUSIYA=1
